# ==============================================================================
# Midland Oil Company Assets Management System - Environment Variables
# IMPORTANT: Replace all "CHANGE_ME_BEFORE_DEPLOY" values with secure secrets before deploying!
# ==============================================================================

# GEMINI_API_KEY: Optional for AI features
GEMINI_API_KEY=

# APP_URL: Injected automatically by hosting platform
APP_URL=

# PostgreSQL — قاعدة البيانات المعتمدة للنظام (المصدر الوحيد للبيانات)
# تُضبط من لوحة التحكم: زر «إعداد PostgreSQL». بدون DATABASE_URL يحفظ الخادم في ملف محلي (.data/store.json) للتجربة فقط.
# مثال: DATABASE_URL=postgres://bms_user:<password>@127.0.0.1:5432/bms_db
DATABASE_URL=
# لقاعدة سحابية تشترط التشفير: DATABASE_SSL=true
DATABASE_SSL=

# مزامنة Firestore (اختيارية): الخادم يرسل نسخة من البيانات إلى Firestore عند توفر الإنترنت، ولا يقرأ منه.
# المسار إلى ملف مفتاح حساب الخدمة (JSON) من Firebase. الملف نفسه لا يُرفع إلى المستودع.
FIREBASE_SERVICE_ACCOUNT_PATH=
# اختياري: معرّف قاعدة Firestore إن لم تكن الافتراضية
FIRESTORE_DATABASE_ID=

# API Authentication Secret Key
# MUST be customized with a secure key before deployment
API_SECRET_KEY=CHANGE_ME_BEFORE_DEPLOY

# إعداد Docker Compose (اختياري — فقط عند استخدام docker-compose up)
POSTGRES_USER=bms_user
POSTGRES_PASSWORD=CHANGE_ME_DOCKER
POSTGRES_DB=bms_db

# Google Maps Platform API Key (for interactive satellite maps, location picker & GPS navigation)
VITE_GOOGLE_MAPS_API_KEY=

# Node.js Built-in HTTPS SSL Certificate Configuration (Windows Server / Standalone)
HTTPS_CERT_PATH=
HTTPS_KEY_PATH=


