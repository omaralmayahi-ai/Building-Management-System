# ==============================================================================
# Midland Oil Company Assets Management System - Environment Variables
# IMPORTANT: Replace all "CHANGE_ME_BEFORE_DEPLOY" values with secure secrets before deploying!
# ==============================================================================

# GEMINI_API_KEY: Optional for AI features
GEMINI_API_KEY=

# APP_URL: Injected automatically by hosting platform
APP_URL=

# PostgreSQL Database Configuration
# MUST be customized with production credentials before deployment
POSTGRES_USER=oil_user
POSTGRES_PASSWORD=CHANGE_ME_BEFORE_DEPLOY
POSTGRES_DB=midland_assets_db
DATABASE_URL=postgres://oil_user:CHANGE_ME_BEFORE_DEPLOY@db:5432/midland_assets_db

# API Authentication Secret Key
# MUST be customized with a secure key before deployment
API_SECRET_KEY=CHANGE_ME_BEFORE_DEPLOY
VITE_API_KEY=CHANGE_ME_BEFORE_DEPLOY

# Google Maps Platform API Key (for interactive satellite maps, location picker & GPS navigation)
VITE_GOOGLE_MAPS_API_KEY=

# Node.js Built-in HTTPS SSL Certificate Configuration (Windows Server / Standalone)
HTTPS_CERT_PATH=
HTTPS_KEY_PATH=


