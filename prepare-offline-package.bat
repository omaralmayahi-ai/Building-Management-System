@echo off
chcp 65001 >nul
title شركة نفط الوسط - تجهيز حزمة التشغيل دون إنترنت (Offline Packager)
color 0B

echo ==============================================================================
echo       وزارة النفط العراقية - شركة نفط الوسط (MDOC)
echo       السجل الرقمي الموحد للأصول الهندسية والإنشائية
echo       سكربت تجهيز حزمة العمل المنفصلة عن الإنترنت (Air-Gapped / Offline)
echo ==============================================================================
echo.
echo يُرجى تشغيل هذا السكربت على جهاز كمبيوتر متصل بالإنترنت لتحميل وبناء
echo كافة الملفات والمكتبات قبل نقلها للسيرفر الداخلي المعزول.
echo.

:: 1. التحقق من Node.js
where node >nul 2>nul
if %errorlevel% neq 0 (
    color 0C
    echo [خطأ] Node.js غير مثبت على هذا الجهاز.
    pause
    exit /b 1
)

:: 2. تثبيت الحزم بالكامل مع بيئة التطوير والإنتاج
echo [1/4] تنزيل وتثبيت جميع الاعتماديات والمكتبات الكاملة...
call npm install
if %errorlevel% neq 0 (
    color 0C
    echo [خطأ] فشل تحميل الاعتماديات.
    pause
    exit /b 1
)

:: 3. بناء ملفات الإنتاج المترجمة
echo.
echo [2/4] تجميع وبناء ملفات الإنتاج (Production Build)...
call npm run build
if %errorlevel% neq 0 (
    color 0C
    echo [خطأ] فشل بناء ملفات المشروع.
    pause
    exit /b 1
)

:: 4. التأكد من ملفات التخزين المحلي والبيئة
echo.
echo [3/4] تجهيز ملفات البيانات والبيئة الافتراضية...
if not exist ".env" (
    if exist ".env.example" copy ".env.example" ".env" >nul
)

:: 5. إعلام المستخدم باكتمال التجهيز
echo.
echo ==============================================================================
echo [4/4] اكتمل تجهيز الحزمة بنجاح!
echo ==============================================================================
echo للتشغيل على سيرفر Windows Server غير متصل بالإنترنت:
echo 1. انسخ مجلد المشروع بالكامل (بما فيه مجلد node_modules ومجلد dist)
echo    إلى فلاشة USB أو وحدة تخزين خارجية.
echo 2. انقل المجلد إلى السيرفر الداخلي المعزول.
echo 3. تأكد من تثبيت برنامج Node.js على السيرفر المعزول (عبر ملف التثبيت msi).
echo 4. شغّل ملف "setup-offline-windows.bat" أو "start-server.bat" مباشرة على السيرفر.
echo ==============================================================================
echo.
pause
